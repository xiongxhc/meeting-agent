{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xiongxhc/meeting-agent/protocols/bridge-session-v2.schema.json",
  "title": "bridge-session/v2",
  "description": "Opt-in timed Mac producer contract. Runtime source and bridge identity are distinct. JSON decimal integers are checked uint64; UTF-8/envelope bounds, chronology, identity binding and stream ordering are also enforced by both language validators. No PCM is permitted. Legacy v1 stays frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commands",
    "events"
  ],
  "properties": {
    "commands": {
      "type": "array",
      "description": "Coordinator-to-bridge commands, in issue order.",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "events": {
      "type": "array",
      "description": "Bridge-to-coordinator events, in observation order. sequence is strictly increasing per session; gaps are allowed, repeats and regressions are rejected.",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "schemaVersion": {
      "const": "bridge-session/v2"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "utcTimestamp": {
      "type": "string",
      "description": "UTC instant, second or millisecond precision, always Z-suffixed.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mediaFormat": {
      "type": "string",
      "description": "A PCM stream shape, in the four-part wire form <encoding>/<sampleRate>/<channels>/<frameMs>ms, e.g. pcm_s16le/48000/1/20ms. The pattern is here because the bridge parses this string: AudioFormat.parse in bridges/mac/Sources/FeishuBridgeSpike/AudioBridge.swift accepts exactly this grammar and refuses anything else rather than substituting a default, so a format the schema admits but the bridge cannot parse would be a session the coordinator could open and the bridge could only reject.",
      "pattern": "^[^/]+/[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*ms$"
    },
    "command": {
      "description": "One coordinator-to-bridge command.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "commandId",
            "type",
            "meetingOccurrenceId",
            "meetingNo",
            "leaseId"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "commandId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "join"
            },
            "meetingOccurrenceId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "meetingNo": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "leaseId": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "commandId",
            "type",
            "mediaLease"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "commandId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "connect_media"
            },
            "mediaLease": {
              "$ref": "#/$defs/mediaLease"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "commandId",
            "type",
            "text"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "commandId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "post_disclosure"
            },
            "text": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "commandId",
            "type",
            "reason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "commandId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "leave"
            },
            "reason": {
              "enum": [
                "meeting_ended",
                "coordinator_stop"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "commandId",
            "type",
            "leaseId"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "commandId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "release_lease"
            },
            "leaseId": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "event": {
      "description": "One bridge-to-coordinator observation.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "meetingOccurrenceId",
            "observationTiming",
            "observationTimingReason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "joined"
            },
            "meetingOccurrenceId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "observationTiming": {
              "oneOf": [
                {
                  "$ref": "#/$defs/observationTiming"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observationTimingReason": {
              "enum": [
                null,
                "timing_unavailable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "observationTiming"
                ],
                "properties": {
                  "observationTiming": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "observationTimingReason": {
                    "const": "timing_unavailable"
                  }
                }
              },
              "else": {
                "properties": {
                  "observationTimingReason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "reason",
            "observationTiming",
            "observationTimingReason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "left"
            },
            "reason": {
              "enum": [
                "ended",
                "removed",
                "bridge_failure"
              ]
            },
            "observationTiming": {
              "oneOf": [
                {
                  "$ref": "#/$defs/observationTiming"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observationTimingReason": {
              "enum": [
                null,
                "timing_unavailable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "observationTiming"
                ],
                "properties": {
                  "observationTiming": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "observationTimingReason": {
                    "const": "timing_unavailable"
                  }
                }
              },
              "else": {
                "properties": {
                  "observationTimingReason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "feishuUserId",
            "displayName",
            "observationTiming",
            "observationTimingReason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "participant_joined"
            },
            "feishuUserId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "displayName": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "observationTiming": {
              "oneOf": [
                {
                  "$ref": "#/$defs/observationTiming"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observationTimingReason": {
              "enum": [
                null,
                "timing_unavailable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "observationTiming"
                ],
                "properties": {
                  "observationTiming": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "observationTimingReason": {
                    "const": "timing_unavailable"
                  }
                }
              },
              "else": {
                "properties": {
                  "observationTimingReason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "feishuUserId",
            "observationTiming",
            "observationTimingReason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "participant_left"
            },
            "feishuUserId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "observationTiming": {
              "oneOf": [
                {
                  "$ref": "#/$defs/observationTiming"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observationTimingReason": {
              "enum": [
                null,
                "timing_unavailable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "observationTiming"
                ],
                "properties": {
                  "observationTiming": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "observationTimingReason": {
                    "const": "timing_unavailable"
                  }
                }
              },
              "else": {
                "properties": {
                  "observationTimingReason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "description": "Speaker identity is never guessed. confidence ui_exact requires a user id; confidence ambiguous requires feishuUserId to stay null.",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "feishuUserId",
            "confidence",
            "observationTiming",
            "observationTimingReason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "active_speaker"
            },
            "feishuUserId": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nonEmptyString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "enum": [
                "ui_exact",
                "ambiguous"
              ]
            },
            "observationTiming": {
              "oneOf": [
                {
                  "$ref": "#/$defs/observationTiming"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observationTimingReason": {
              "enum": [
                null,
                "timing_unavailable"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "confidence"
                ],
                "properties": {
                  "confidence": {
                    "const": "ui_exact"
                  }
                }
              },
              "then": {
                "properties": {
                  "feishuUserId": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "confidence"
                ],
                "properties": {
                  "confidence": {
                    "const": "ambiguous"
                  }
                }
              },
              "then": {
                "properties": {
                  "feishuUserId": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "observationTiming"
                ],
                "properties": {
                  "observationTiming": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "observationTimingReason": {
                    "const": "timing_unavailable"
                  }
                }
              },
              "else": {
                "properties": {
                  "observationTimingReason": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "direction",
            "startedAt",
            "endedAt"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "audio_gap"
            },
            "direction": {
              "enum": [
                "capture",
                "playback"
              ]
            },
            "startedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "endedAt": {
              "oneOf": [
                {
                  "$ref": "#/$defs/utcTimestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "outcome"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "chat_disclosure"
            },
            "outcome": {
              "enum": [
                "sent",
                "unavailable",
                "failed"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "endpoint"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "media_connected"
            },
            "endpoint": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "reason"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "media_disconnected"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "description": "commandId must name a command the coordinator actually issued in this session.",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "commandId",
            "outcome",
            "detail"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "command_result"
            },
            "commandId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "outcome": {
              "enum": [
                "ok",
                "rejected",
                "failed"
              ]
            },
            "detail": {
              "oneOf": [
                {
                  "$ref": "#/$defs/nonEmptyString"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "attempt"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "reconnecting"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "attempt"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "reconnected"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sessionId",
            "sequence",
            "observedAt",
            "type",
            "snapshotSequence",
            "observationTiming",
            "state",
            "feishuUserId",
            "reason",
            "barrierBefore"
          ],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaVersion"
            },
            "sessionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sequence": {
              "$ref": "#/$defs/sequence"
            },
            "observedAt": {
              "$ref": "#/$defs/utcTimestamp"
            },
            "type": {
              "const": "ui_snapshot"
            },
            "snapshotSequence": {
              "$ref": "#/$defs/sequence"
            },
            "observationTiming": {
              "oneOf": [
                {
                  "$ref": "#/$defs/observationTiming"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "enum": [
                "ui_exact",
                "ambiguous",
                "unknown",
                "unreadable"
              ]
            },
            "feishuUserId": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "enum": [
                null,
                "no_highlight",
                "identity_unavailable",
                "grid_unavailable",
                "snapshot_unreadable",
                "timing_unavailable"
              ]
            },
            "barrierBefore": {
              "enum": [
                null,
                "stream_start",
                "observation_drop",
                "poll_gap",
                "clock_reset"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "ui_exact"
                  }
                }
              },
              "then": {
                "properties": {
                  "feishuUserId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "reason": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "ambiguous"
                  }
                }
              },
              "then": {
                "properties": {
                  "feishuUserId": {
                    "type": "null"
                  },
                  "reason": {
                    "enum": [
                      null,
                      "identity_unavailable"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "unknown"
                  }
                }
              },
              "then": {
                "properties": {
                  "feishuUserId": {
                    "type": "null"
                  },
                  "reason": {
                    "enum": [
                      "no_highlight",
                      "identity_unavailable"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "unreadable"
                  }
                }
              },
              "then": {
                "properties": {
                  "feishuUserId": {
                    "type": "null"
                  },
                  "reason": {
                    "enum": [
                      "grid_unavailable",
                      "snapshot_unreadable",
                      "timing_unavailable"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "observationTiming"
                ],
                "properties": {
                  "observationTiming": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "state": {
                    "const": "unreadable"
                  },
                  "reason": {
                    "const": "timing_unavailable"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "not": {
                      "const": "timing_unavailable"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20,
      "format": "uint64-decimal"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "capture-identifier"
    },
    "observationTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clockDomainId",
        "hostBeforeNs",
        "hostAfterNs"
      ],
      "properties": {
        "clockDomainId": {
          "$ref": "#/$defs/identifier"
        },
        "hostBeforeNs": {
          "$ref": "#/$defs/uint64"
        },
        "hostAfterNs": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "mediaLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "bridgeSessionId",
        "connectEndpoint",
        "credential",
        "expiresAtMs",
        "reconnectWindowMs",
        "mediaProtocolVersion",
        "captureFormat",
        "timingContract"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/uint64"
        },
        "bridgeSessionId": {
          "$ref": "#/$defs/identifier"
        },
        "connectEndpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expiresAtMs": {
          "$ref": "#/$defs/uint64"
        },
        "reconnectWindowMs": {
          "$ref": "#/$defs/uint64"
        },
        "mediaProtocolVersion": {
          "const": 2
        },
        "captureFormat": {
          "const": "pcm_s16le/24000/1/20ms"
        },
        "timingContract": {
          "const": "capture-clock/v1"
        }
      }
    }
  }
}
