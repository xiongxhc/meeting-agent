{
  "name": "meeting-agent",
  "version": "0.1.0",
  "description": "Reusable meeting engine: joins, transcribes, and reports on meetings.",
  "type": "module",
  "files": ["dist", "scripts/check-runtime-sdk.mjs"],
  "peerDependencies": { "@conversation/runtime": "0.1.0" },
  "peerDependenciesMeta": { "@conversation/runtime": { "optional": true } },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/application.d.ts",
      "import": "./dist/src/application.js"
    }
  },
  "scripts": {
    "pretest": "node scripts/check-runtime-sdk.mjs",
    "pretypecheck": "node scripts/check-runtime-sdk.mjs",
    "prebuild": "node scripts/check-runtime-sdk.mjs",
    "prestart": "node scripts/check-runtime-sdk.mjs",
    "test": "node --test \"spikes/**/*.test.ts\" \"bridges/**/*.test.ts\" \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "e2e": "node e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc && node -e \"require('fs').cpSync('migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/src/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.1",
    "@types/ws": "8.5.10",
    "ajv": "^8.20.0",
    "eslint": "^9.37.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  }
}
