{
  "name": "meeting-agent",
  "version": "0.1.0",
  "description": "Reusable meeting engine: joins, transcribes, and reports on meetings.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/config.d.ts",
      "import": "./dist/src/config.js"
    }
  },
  "scripts": {
    "test": "node --test \"spikes/**/*.test.ts\" \"bridges/**/*.test.ts\" \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc",
    "start": "node dist/src/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.9.1",
    "ajv": "^8.20.0",
    "eslint": "^9.37.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
